[Unit]
Description=VAR-Scope controlled camera runner
After=local-fs.target

[Service]
Type=simple
Environment=SERVICE_MODE=camera-runner
Environment=CAMERA_SOCKET=/run/var-scope-camera/camera.sock
ExecStart=/opt/var-scope/bin/var-scope-server
Restart=on-failure
RestartSec=2s
RuntimeDirectory=var-scope-camera
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
