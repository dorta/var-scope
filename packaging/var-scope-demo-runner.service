[Unit]
Description=VAR-Scope controlled GPU demo runner
After=weston.service
Wants=weston.service

[Service]
Type=simple
Environment=SERVICE_MODE=gpu-demo-runner
Environment=DEMO_SOCKET=/run/var-scope-demo/demo.sock
ExecStart=/opt/var-scope/bin/var-scope-server
Restart=on-failure
RestartSec=2s
RuntimeDirectory=var-scope-demo
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
